###
POST http://localhost:8082/realms/insurance/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type = password &
client_id = insurance-service &
username = policyholder &
password = policyholder

> {%
    client.global.set("policyholder_token", response.body.access_token);
%}

###
POST http://localhost:8082/realms/insurance/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type = password &
client_id = insurance-service &
username = underwriter &
password = underwriter

> {%
    client.global.set("underwriter_token", response.body.access_token);
%}